{
  "name": "@tomgrv/svc-k3s",
  "version": "4.8.0",
  "description": "k3s / kubectl / helm install (includes Traefik configuration)",
  "bin": {
    "svc-k3s": "run.sh"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "default": true,
    "inputs": {
      "K3S_EXTRA_ARGS": {
        "description": "Extra flags passed to the k3s installer",
        "required": false,
        "default": ""
      },
      "K3S_VERSION": {
        "description": "k3s version to pin (empty = latest stable)",
        "required": false,
        "default": ""
      },
      "K3S_TRAEFIK_ACME_EMAIL": {
        "description": "Contact email registered with Let's Encrypt",
        "required": false,
        "default": "admin@example.com"
      },
      "K3S_TRAEFIK_ACME_STAGING": {
        "description": "Use Let's Encrypt's staging environment (true/false)",
        "required": false,
        "default": "true"
      }
    },
    "order": 4,
    "outputs": {
      "KUBECONFIG": {
        "description": "Path to the k3s kubeconfig",
        "value": "/etc/rancher/k3s/k3s.yaml"
      }
    },
    "ports": [
      {
        "name": "k3s_http",
        "port": 80,
        "access": "public",
        "note": "HTTP Traefik ingress, also required for the Lets Encrypt HTTP-01 challenge"
      },
      {
        "name": "k3s_https",
        "port": 443,
        "access": "public",
        "note": "HTTPS Traefik ingress"
      },
      {
        "name": "k3s_traefik_dashboard",
        "port": 8088,
        "access": "private"
      }
    ],
    "requires": {
      "root": true,
      "os": "ubuntu"
    },
    "summary": true
  }
}
