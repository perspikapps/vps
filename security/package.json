{
    "name": "@tomgrv/vps-security",
    "version": "1.0.0",
    "description": "Firewall / SSH / fail2ban hardening",
    "bin": {
        "security": "run.sh"
    },
    "dependencies": {
        "@tomgrv/vps-common": "*"
    },
    "private": true,
    "vps": {
        "default": true,
        "inputs": {
            "SSH_PORT": {
                "description": "SSH port to keep open",
                "required": false,
                "default": "22"
            },
            "VPS_ADMIN_PASSWORD": {
                "description": "Cockpit/console login password for VPS_ADMIN_USER (or root if unset)",
                "required": false,
                "default": ""
            },
            "VPS_ADMIN_SSH_KEY": {
                "description": "Public key to authorize for VPS_ADMIN_USER and root",
                "required": false,
                "default": ""
            },
            "VPS_ADMIN_USER": {
                "description": "Optional non-root sudo user to create",
                "required": false,
                "default": ""
            }
        },
        "order": 1,
        "outputs": {
            "COCKPIT_ADMIN_PASSWORD_FILE": {
                "description": "Path to the saved Cockpit/console login password",
                "value": "/root/.cockpit-admin-password"
            }
        },
        "ports": [
            {
                "name": "ssh",
                "port": 22,
                "access": "public",
                "note": "SSH"
            }
        ]
    }
}
