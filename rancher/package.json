{
    "name": "@vps/rancher",
    "version": "1.0.0",
    "description": "Rancher install",
    "bin": {
        "rancher": "run.sh"
    },
    "dependencies": {
        "@vps/k3s": "*",
        "@vps/common": "*"
    },
    "private": true,
    "vps": {
        "order": 5,
        "default": true,
        "ports": [
            {
                "name": "rancher_http",
                "port": 7080,
                "access": "tailscale"
            },
            {
                "name": "rancher_https",
                "port": 7083,
                "access": "tailscale"
            }
        ]
    }
}
