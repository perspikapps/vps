#!/usr/bin/env bats
# Static checks for vps-security/run.sh and package.json - a live install
# needs a real root Ubuntu box, so this stops at syntax + shape (see
# this folder's README's "Tests" section, and ../tests/ for repo-wide checks).

REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME}")/.." && pwd)"
DIR="$REPO_ROOT/vps-security"

@test "run.sh parses as POSIX sh" {
    run dash -n "$DIR/run.sh"
    [ "$status" -eq 0 ]
}

@test "run.sh sources nothing but zz-colors and calls the vps scripts instead" {
    grep -q '^\. zz-colors$' "$DIR/run.sh"
    [ -z "$(grep -E '^\s*(\.|source) ' "$DIR/run.sh" | grep -v '\. zz-colors')" ]
}

@test "run.sh does not bootstrap zz-use itself (assumes setup.sh already ran)" {
    ! grep -q 'command -v zz-use' "$DIR/run.sh"
    ! grep -q 'curl -fsSL.*setup\.sh.*| sh$' "$DIR/run.sh"
}

@test "defines up() and dispatches its action" {
    grep -q '^up() {' "$DIR/run.sh"
    grep -q '^case "\${1:-}" in' "$DIR/run.sh"
    ! grep -q 'dispatch_action\|zz-step' "$DIR/run.sh"
}

@test "defines down()" {
    grep -q '^down() {' "$DIR/run.sh"
}

@test "package.json bin entry matches the folder name" {
    run node -e "const p = require('$DIR/package.json'); process.exit(p.bin['vps-security'] === 'run.sh' ? 0 : 1)"
    [ "$status" -eq 0 ]
}

@test "package.json declares vps.order as a number" {
    run node -e "const p = require('$DIR/package.json'); process.exit(typeof p.config.order === 'number' ? 0 : 1)"
    [ "$status" -eq 0 ]
}



@test "run.sh opens private-access ports on the interface vps-network reports, not a hard-coded one" {
    grep -q 'private_iface="\$("\$vps_network" private-interface)"' "$DIR/run.sh"
    ! grep -q 'tailscale0' "$DIR/run.sh"
    ! grep -q '^    tailscale)' "$DIR/run.sh"
}

@test "no package.json declares a tailscale port access any more" {
    ! grep -q '"access": "tailscale"' "$REPO_ROOT"/*/package.json
}

# The guard script is generated by run.sh; run it against stubbed ip/iptables.
guard_setup() {
    sed -n "/<<'GUARD'/,/^GUARD$/p" "$DIR/run.sh" | sed '1d;$d' >"$BATS_TEST_TMPDIR/guard.sh"
    mkdir -p "$BATS_TEST_TMPDIR/bin"
    printf '#!/bin/sh\necho "default via 10.0.0.1 dev eth0"\n' >"$BATS_TEST_TMPDIR/bin/ip"
    printf '#!/bin/sh\necho "$*" >>"$IPT_LOG"\ncase "$1" in -D) exit 1 ;; esac\n' >"$BATS_TEST_TMPDIR/bin/iptables"
    chmod +x "$BATS_TEST_TMPDIR"/bin/*
    export IPT_LOG="$BATS_TEST_TMPDIR/ipt.log"
    : >"$IPT_LOG"
}

@test "the private-ports guard script parses as sh" {
    guard_setup
    [ -s "$BATS_TEST_TMPDIR/guard.sh" ]
    run sh -n "$BATS_TEST_TMPDIR/guard.sh"
    [ "$status" -eq 0 ]
}

@test "the guard drops DNAT-ed connections to each private port on the default-route interface, first in FORWARD" {
    guard_setup
    run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" sh "$BATS_TEST_TMPDIR/guard.sh" add tailscale0 7080 3000
    [ "$status" -eq 0 ]
    grep -qx -- '-I FORWARD 1 -i eth0 -p tcp -m conntrack --ctstate DNAT --ctorigdstport 7080 -j DROP' "$IPT_LOG"
    grep -qx -- '-I FORWARD 1 -i eth0 -p tcp -m conntrack --ctstate DNAT --ctorigdstport 3000 -j DROP' "$IPT_LOG"
}

@test "the guard re-inserts instead of stacking, does nothing when the private network is the default route, and deletes on del" {
    guard_setup
    run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" sh "$BATS_TEST_TMPDIR/guard.sh" add tailscale0 7080
    # -D first (a previous copy is removed), then -I
    [ "$(sed -n 1p "$IPT_LOG" | cut -c1-2)" = "-D" ]
    : >"$IPT_LOG"
    run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" sh "$BATS_TEST_TMPDIR/guard.sh" add eth0 7080
    [ "$status" -eq 0 ]
    [ ! -s "$IPT_LOG" ]
    run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" sh "$BATS_TEST_TMPDIR/guard.sh" del tailscale0 7080
    [ "$status" -eq 0 ]
    ! grep -q -- '-I FORWARD' "$IPT_LOG"
}

@test "run.sh feeds the guard every access:private port of every feature, and down removes it" {
    grep -q 'install_private_guard "\${private_iface:--}" "\$("\$vps_network" ports | awk' "$DIR/run.sh"
    grep -q '"\$GUARD_BIN" del -' "$DIR/run.sh"
}

@test "private ports are opened only to the private address, with no blanket allow on the interface" {
    grep -q 'private_ip="\$("\$vps_network" private-address)"' "$DIR/run.sh"
    grep -q 'to "\$private_ip" port' "$DIR/run.sh"
    ! grep -q 'ufw allow in on "\$private_iface" comment' "$DIR/run.sh"
}

@test "ufw rules are upserted via fw(), not rebuilt after a reset on every run" {
    grep -q '^fw() {' "$DIR/run.sh"
    grep -q 'ufw_state" ] || ufw --force reset' "$DIR/run.sh"
    ! grep -q '^ufw --force reset' "$DIR/run.sh"
    # only fw() itself calls `ufw allow`
    [ -z "$(grep -E '^\s+ufw allow ' "$DIR/run.sh" | grep -v 'ufw allow "\$@"')" ]
}

@test "firewall and admin user are distribution-aware (ufw/firewalld, ssh/sshd, useradd)" {
    grep -q 'firewall=firewalld' "$DIR/run.sh"
    grep -q 'ssh_unit=sshd' "$DIR/run.sh"
    grep -q 'useradd -m' "$DIR/run.sh"
    ! grep -q 'adduser' "$DIR/run.sh"
}
