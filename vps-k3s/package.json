{
    "name": "@tomgrv/vps-k3s",
    "version": "1.0.0",
    "description": "k3s / kubectl / helm install (includes Traefik configuration)",
    "bin": {
        "vps-k3s": "run.sh"
    },
    "dependencies": {
        "@tomgrv/vps-common": "*"
    },
    "private": true,
    "vps": {
        "default": true,
        "inputs": {
            "K3S_EXTRA_ARGS": {
                "description": "Extra flags passed to the k3s installer",
                "required": false,
                "default": ""
            },
            "K3S_VERSION": {
                "description": "Pin a k3s version",
                "required": false,
                "default": ""
            },
            "TRAEFIK_ACME_EMAIL": {
                "description": "Contact email registered with Let's Encrypt",
                "required": false,
                "default": "admin@example.com"
            },
            "TRAEFIK_ACME_STAGING": {
                "description": "Use Let's Encrypt's staging environment (true/false)",
                "required": false,
                "default": "true"
            },
            "TRAEFIK_DASHBOARD_PORT": {
                "description": "Traefik dashboard port (Tailscale-only)",
                "required": false,
                "default": "8088"
            }
        },
        "order": 4,
        "outputs": {
            "KUBECONFIG": {
                "description": "Path to the k3s kubeconfig",
                "value": "/etc/rancher/k3s/k3s.yaml"
            }
        },
        "ports": [
            {
                "name": "http",
                "port": 80,
                "access": "public",
                "note": "HTTP (Traefik ingress; also required for the Let's Encrypt HTTP-01 challenge)"
            },
            {
                "name": "https",
                "port": 443,
                "access": "public",
                "note": "HTTPS (Traefik ingress)"
            },
            {
                "name": "traefik_dashboard",
                "port": 8088,
                "access": "tailscale"
            }
        ]
    },
    "scripts": {
        "test": "bats test.bats"
    }
}
