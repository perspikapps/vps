{
    "name": "@tomgrv/vps-system",
    "version": "1.0.0",
    "description": "Base system update & essentials",
    "bin": {
        "system": "run.sh"
    },
    "dependencies": {
        "@tomgrv/vps-common": "*"
    },
    "private": true,
    "vps": {
        "default": true,
        "inputs": {
            "TZ": {
                "description": "Timezone to set on the VPS (e.g. Europe/Paris)",
                "required": false,
                "default": ""
            }
        },
        "order": 0,
        "outputs": {}
    }
}
