{
  "name": "@tomgrv/vps-marketplace",
  "version": "4.0.0",
  "description": "Rancher Apps & Marketplace catalog registration",
  "bin": {
    "vps-marketplace": "run.sh"
  },
  "dependencies": {
    "@tomgrv/vps-common": "*",
    "@tomgrv/vps-rancher": "*"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "default": true,
    "inputs": {
      "MARKETPLACE_REPO_NAME": {
        "description": "Name of the Rancher ClusterRepo to register",
        "required": false,
        "default": "perspikapps-vps"
      },
      "MARKETPLACE_REPO_URL": {
        "description": "URL of the Helm chart catalog to register",
        "required": false,
        "default": "https://perspikapps.github.io/vps/"
      }
    },
    "order": 7,
    "outputs": {},
    "requires": {
      "root": true,
      "os": "ubuntu"
    },
    "summary": true
  }
}
