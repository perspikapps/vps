{
  "name": "@tomgrv/vps-rancher",
  "version": "4.0.0",
  "description": "Rancher install",
  "bin": {
    "vps-rancher": "run.sh"
  },
  "dependencies": {
    "@tomgrv/vps-k3s": "*",
    "@tomgrv/vps-common": "*"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "default": true,
    "inputs": {
      "CERT_MANAGER_VERSION": {
        "description": "Pin cert-manager's chart version",
        "required": false,
        "default": ""
      },
      "RANCHER_BOOTSTRAP_PASSWORD": {
        "description": "Initial admin password",
        "required": false,
        "default": "",
        "secret": true
      },
      "RANCHER_CHART_REPO_URL": {
        "description": "Helm repository to install Rancher from (e.g. https://charts.rancher.com/server-charts/prime for SUSE Rancher Prime)",
        "required": false,
        "default": "https://releases.rancher.com/server-charts/latest"
      },
      "RANCHER_CHART_VERSION": {
        "description": "Pin a chart version",
        "required": false,
        "default": ""
      },
      "RANCHER_HOSTNAME": {
        "description": "FQDN/IP used in Rancher's self-signed cert",
        "required": false,
        "default": ""
      },
      "RANCHER_HTTPS_PORT": {
        "description": "Rancher HTTPS port",
        "required": false,
        "default": "7083"
      },
      "RANCHER_HTTP_PORT": {
        "description": "Rancher HTTP port",
        "required": false,
        "default": "7080"
      }
    },
    "order": 5,
    "outputs": {
      "RANCHER_BOOTSTRAP_PASSWORD_FILE": {
        "description": "Owner-only env file holding RANCHER_BOOTSTRAP_PASSWORD (the saved Rancher bootstrap password)",
        "value": "/root/.vps-secrets.env"
      }
    },
    "ports": [
      {
        "name": "rancher_http",
        "port": 7080,
        "access": "private"
      },
      {
        "name": "rancher_https",
        "port": 7083,
        "access": "private"
      }
    ]
  }
}
