{
    "name": "@vps/cockpit",
    "version": "1.0.0",
    "description": "Cockpit install",
    "config": {
        "default": true,
        "inputs": {
            "COCKPIT_HTTPS_PORT": {
                "description": "Cockpit HTTPS port",
                "required": false,
                "default": "9083"
            },
            "COCKPIT_HTTP_PORT": {
                "description": "Cockpit HTTP port",
                "required": false,
                "default": "9080"
            }
        },
        "order": 3,
        "outputs": {},
        "ports": [
            {
                "name": "cockpit_http",
                "port": 9080,
                "access": "tailscale"
            },
            {
                "name": "cockpit_https",
                "port": 9083,
                "access": "tailscale"
            }
        ]
    },
    "dependencies": {},
    "private": true
}
