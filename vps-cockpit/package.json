{
  "name": "@tomgrv/vps-cockpit",
  "version": "4.3.0",
  "description": "Cockpit install",
  "bin": {
    "vps-cockpit": "run.sh"
  },
  "dependencies": {
    "@tomgrv/vps-common": "*"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
