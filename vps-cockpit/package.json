{
  "name": "@tomgrv/vps-cockpit",
  "version": "4.3.0",
  "description": "Cockpit install",
  "bin": {
    "vps-cockpit": "run.sh"
  },
  "dependencies": {
    "@tomgrv/vps-common": "*"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "default": true,
    "inputs": {
      "COCKPIT_HTTPS_PORT": {
        "description": "Cockpit HTTPS port",
        "required": false,
        "default": "9083"
      },
      "COCKPIT_HTTP_PORT": {
        "description": "Cockpit HTTP port",
        "required": false,
        "default": "9080"
      }
    },
    "order": 3,
    "outputs": {},
    "ports": [
      {
        "name": "cockpit_http",
        "port": 9080,
        "access": "private"
      },
      {
        "name": "cockpit_https",
        "port": 9083,
        "access": "private"
      }
    ]
  }
}
