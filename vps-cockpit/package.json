{
  "name": "@tomgrv/vps-cockpit",
  "version": "4.5.0",
  "description": "Cockpit install",
  "bin": {
    "vps-cockpit": "run.sh"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "default": true,
    "inputs": {
      "SYSTEM_SECRETS_FILE": {
        "description": "Owner-only env file holding the credentials the steps generate",
        "required": false,
        "default": "/root/.vps-secrets.env"
      }
    },
    "order": 3,
    "outputs": {},
    "ports": [
      {
        "name": "system_cockpit_http",
        "port": 9080,
        "access": "private"
      },
      {
        "name": "system_cockpit_https",
        "port": 9083,
        "access": "private"
      }
    ],
    "requires": {
      "root": true,
      "os": "ubuntu"
    },
    "summary": true
  }
}
