{
    "name": "@tomgrv/vps-github-arc",
    "version": "1.0.0",
    "description": "GitHub Actions Runner Controller (ARC) install",
    "bin": {
        "vps-github-arc": "run.sh"
    },
    "dependencies": {
        "@tomgrv/vps-k3s": "*",
        "@tomgrv/vps-common": "*"
    },
    "private": true,
    "vps": {
        "default": false,
        "inputs": {
            "GITHUB_ARC_APP_ID": {
                "description": "GitHub App ID",
                "required": true,
                "default": ""
            },
            "GITHUB_ARC_APP_INSTALLATION_ID": {
                "description": "GitHub App installation ID",
                "required": true,
                "default": ""
            },
            "GITHUB_ARC_APP_PRIVATE_KEY_FILE": {
                "description": "Path to the GitHub App's private key PEM file",
                "required": true,
                "default": ""
            },
            "GITHUB_ARC_CONFIG_URL": {
                "description": "Org or repo URL runners register against",
                "required": true,
                "default": ""
            },
            "GITHUB_ARC_CONTROLLER_CHART_VERSION": {
                "description": "Pin the controller chart version",
                "required": false,
                "default": ""
            },
            "GITHUB_ARC_INSTALL_TIMEOUT": {
                "description": "How long to wait for each helm install",
                "required": false,
                "default": "10m"
            },
            "GITHUB_ARC_MAX_RUNNERS": {
                "description": "Maximum runners",
                "required": false,
                "default": "5"
            },
            "GITHUB_ARC_MIN_RUNNERS": {
                "description": "Minimum idle runners",
                "required": false,
                "default": "0"
            },
            "GITHUB_ARC_RUNNER_SCALE_SET_NAME": {
                "description": "Name of the runner scale set",
                "required": false,
                "default": "arc-runner-set"
            },
            "GITHUB_ARC_RUNNER_SET_CHART_VERSION": {
                "description": "Pin the runner scale set chart version",
                "required": false,
                "default": ""
            }
        },
        "order": 9,
        "outputs": {}
    },
    "scripts": {
        "test": "bats test.bats"
    }
}
