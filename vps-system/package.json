{
  "name": "@tomgrv/vps-system",
  "version": "4.8.0",
  "description": "Base system update & essentials",
  "bin": {
    "vps-system": "run.sh"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "default": true,
    "inputs": {
      "SYSTEM_TZ": {
        "description": "Timezone to set on the VPS (e.g. Europe/Paris; empty = unchanged)",
        "required": false,
        "default": ""
      }
    },
    "order": 0,
    "outputs": {},
    "requires": {
      "root": true,
      "os": "ubuntu"
    }
  }
}
