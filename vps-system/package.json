{
  "name": "@tomgrv/vps-system",
  "version": "2.8.0",
  "description": "Base system update & essentials",
  "bin": {
    "vps-system": "run.sh"
  },
  "dependencies": {
    "@tomgrv/vps-common": "*"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "zz": {
      "default": true,
      "inputs": {
        "TZ": {
          "description": "Timezone to set on the VPS (e.g. Europe/Paris)",
          "required": false,
          "default": ""
        }
      },
      "order": 0,
      "outputs": {}
    }
  }
}
