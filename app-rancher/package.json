{
  "name": "@tomgrv/app-rancher",
  "version": "4.5.0",
  "description": "Rancher install",
  "bin": {
    "app-rancher": "run.sh"
  },
  "dependencies": {
    "@tomgrv/svc-k3s": "*"
  },
  "private": true,
  "scripts": {
    "test": "bats test.bats"
  },
  "engines": {
    "zz-setup": "*"
  },
  "config": {
    "visibility": "public",
    "default": true,
    "inputs": {
      "RANCHER_CERT_MANAGER_VERSION": {
        "description": "Pin cert-manager's chart version",
        "required": false,
        "default": ""
      },
      "RANCHER_BOOTSTRAP_PASSWORD": {
        "description": "Initial admin password",
        "required": false,
        "default": "",
        "secret": true
      },
      "RANCHER_CHART_REPO_URL": {
        "description": "Helm repository to install Rancher from (e.g. https://charts.rancher.com/server-charts/prime for SUSE Rancher Prime)",
        "required": false,
        "default": "https://releases.rancher.com/server-charts/latest"
      },
      "RANCHER_CHART_VERSION": {
        "description": "Pin a chart version",
        "required": false,
        "default": ""
      },
      "SYSTEM_SECRETS_FILE": {
        "description": "Owner-only env file holding the credentials the steps generate",
        "required": false,
        "default": "/root/.vps-secrets.env"
      }
    },
    "order": 5,
    "outputs": {
      "RANCHER_BOOTSTRAP_PASSWORD_FILE": {
        "description": "Owner-only env file holding RANCHER_BOOTSTRAP_PASSWORD (the saved Rancher bootstrap password)",
        "value": "/root/.vps-secrets.env"
      }
    },
    "requires": {
      "root": true,
      "os": "ubuntu"
    },
    "summary": true
  }
}
